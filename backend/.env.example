# ==============================================================================
# SkillSync AI - Environment Configuration Example
# Copy this file to .env and customize the values for your environment.
# ==============================================================================

# Application Settings
PROJECT_NAME="SkillSync AI"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Database Configuration
# Default: Local SQLite for rapid development and testing
# For SQLite: sqlite:///./skillsync.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/skillsync_ai
DATABASE_URL="sqlite:///./skillsync.db"

# Authentication & Security
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET="changethis_supersecretkey_for_jwt_auth_min_32_chars_long_12345"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External APIs - Job Market Demand (Adzuna)
ADZUNA_APP_ID="your_adzuna_app_id_here"
ADZUNA_APP_KEY="your_adzuna_app_key_here"
ADZUNA_COUNTRY="us"

# AI / Semantic Matching Engine
# Pretrained sentence transformer model name for skill extraction & matching
SEMANTIC_MODEL_NAME="all-MiniLM-L6-v2"
# Cosine similarity score cutoff threshold (0.0 to 1.0) for skill matching
SEMANTIC_SIMILARITY_THRESHOLD=0.65

# Storage for Resumes
UPLOAD_DIR="./uploads/resumes"
MAX_UPLOAD_SIZE_MB=5
